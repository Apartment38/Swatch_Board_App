+        fn text_fully_visible(&self, label: &str) -> bool {
+            let index = self
+                .painted
+                .iter()
+                .rposition(|(text, _)| text == label)
+                .unwrap_or_else(|| {
+                    panic!(
+                        "missing painted text {label:?}; painted: {:?}",
+                        self.painted.iter().map(|(t, _)| t).collect::<Vec<_>>()
+                    )
+                });
+            self.clips[index].contains_rect(self.painted[index].1)
+        }
