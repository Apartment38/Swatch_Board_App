[
  {
    "name": "fmt-apply",
    "command": [
      "cargo",
      "fmt",
      "--all"
    ],
    "exit": 0
  },
  {
    "name": "fmt-check",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "build-final",
    "command": [
      "cargo",
      "build",
      "--offline",
      "--locked",
      "--workspace",
      "--all-targets"
    ],
    "exit": 0
  },
  {
    "name": "regression-green",
    "command": [
      "cargo",
      "test",
      "--offline",
      "--locked",
      "-p",
      "swatch-board",
      "--bin",
      "swatch-board",
      "layout_tests::",
      "--",
      "--nocapture",
      "--test-threads=1"
    ],
    "exit": 0
  },
  {
    "name": "workspace-tests",
    "command": [
      "cargo",
      "test",
      "--offline",
      "--locked",
      "--workspace",
      "--all-targets",
      "--no-fail-fast",
      "--",
      "--test-threads=1"
    ],
    "exit": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--offline",
      "--locked",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "diff-check",
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit": 0
  }
]
