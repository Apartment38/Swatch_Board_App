{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swatch-board.local/schemas/roles.schema.json",
  "title": "Swatch Board color roles, API 1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "default"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$",
        "minLength": 1,
        "maxLength": 128
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "help": {
        "type": "string"
      },
      "default": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
      },
      "alpha": {
        "type": "boolean",
        "description": "Whether an eight-digit #RRGGBBAA value is permitted."
      },
      "group": {
        "type": "string"
      },
      "links": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "examples": [
    [
      {
        "id": "background",
        "title": "Background",
        "help": "Main canvas background",
        "default": "#202020",
        "alpha": false,
        "group": "Canvas",
        "links": []
      }
    ]
  ]
}
