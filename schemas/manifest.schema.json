{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swatch-board.local/schemas/manifest.schema.json",
  "title": "Swatch Board plugin manifest, API 1",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api_version",
    "target",
    "target_versions",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "target_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "template",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Safe relative path within the plugin or chosen export directory; absolute paths, traversal, and symlinks are forbidden."
          },
          "template": {
            "type": "string",
            "minLength": 1,
            "description": "Safe relative path within the plugin or chosen export directory; absolute paths, traversal, and symlinks are forbidden."
          },
          "format": {
            "enum": [
              "ghostty",
              "json",
              "kde",
              "text"
            ]
          }
        }
      }
    }
  },
  "examples": [
    {
      "id": "example",
      "name": "Example",
      "version": "1.0.0",
      "api_version": 1,
      "target": "example",
      "target_versions": [
        "1"
      ],
      "outputs": [
        {
          "path": "example.json",
          "template": "templates/theme.j2",
          "format": "json"
        }
      ]
    }
  ]
}
